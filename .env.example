# Copy this file to `.env` and fill in your own values.
# `.env` is git-ignored. Never put real secrets in this file.

# API key for the model provider
ANTHROPIC_API_KEY=

# Server URL the CLI talks to (also used to build the OAuth redirect URI)
API_URL=http://localhost:3000
DATABASE_URL=

# Sentry DSN for error monitoring (server and CLI). Leave empty to disable monitoring.
SENTRY_DSN=

# Clerk OAuth (CLI `/login`): Frontend API URL and the OAuth application's client ID
CLERK_FRONTEND_API=
CLERK_OAUTH_CLIENT_ID=

# Clerk backend keys (server-side token verification)
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
