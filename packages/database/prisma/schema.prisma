generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ASSISTANT
  ERROR
}

enum Mode {
  BUILD
  PLAN
}

enum MessageStatus {
  COMPLETE
  INTERRUPTED
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  title     String
  cwd       String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([userId])
}

model Message {
  id        String        @id @default(cuid())
  sessionId String
  role      Role
  status    MessageStatus
  model     String
  content   String
  parts     Json?
  mode      Mode
  duration  Int?
  createdAt DateTime      @default(now())
  session   Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// Usage charges that Polar hasn't confirmed yet. A row is deleted once Polar accepts the event,
// so whatever is left after a failed delivery is retried by the server instead of being lost.
model PendingUsageEvent {
  // Polar external_id; Polar deduplicates by it, so redelivering can't bill twice
  id        String   @id
  userId    String
  credits   Int
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}
