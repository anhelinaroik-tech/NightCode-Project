generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  title     String
  cwd       String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Json      @default("[]")

  @@index([userId])
}

// Usage charges that Polar hasn't confirmed yet. A row is deleted once Polar accepts the event,
// so whatever is left after a failed delivery is retried by the server instead of being lost.
model PendingUsageEvent {
  // Polar external_id; Polar deduplicates by it, so redelivering can't bill twice
  id        String   @id
  userId    String
  credits   Int
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}
